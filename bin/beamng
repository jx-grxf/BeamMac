#!/usr/bin/env bash
# Usage: bin/beamng [--d3dmetal|--wined3d] [--hud] [--stock] [--upscaler game|metalfx|off] [--steam-only|--install-game|--background] [--multiplayer] [--update-steam]
source "$(dirname "$0")/../lib/common.sh"

# BeamNG 0.39+ defaults to DirectX 12, which DXMT and D3DMetal do not cover;
# the game only falls back to DX11 after a failed probe. Arguments after the
# app ID go to the game.
steam_args=(-silent -applaunch "$BEAMNG_APPID" -gfx dx11)
steam_only=""
update_steam=""
multiplayer=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --d3dmetal) BACKEND=d3dmetal ;;
    --wined3d) BACKEND=wined3d ;;
    --dxmt) BACKEND=dxmt ;;
    --hud) export BEAMNG_HUD=1 ;;
    --upscaler) UPSCALER="${2:?--upscaler braucht game, metalfx oder off}"; shift ;;
    --no-metalfx) UPSCALER=off ;;
    --stock) PACK=0; UPSCALER=off ;;
    --multiplayer) multiplayer=1 ;;
    # Starts Steam if needed and brings its window up; a running client
    # ignores a bare steam.exe and stays in the tray.
    --steam-only) steam_only=1; steam_args=(steam://open/main) ;;
    --update-steam) update_steam=force ;;
    # Opens Steam's install dialog for BeamNG; Steam asks for the library itself.
    --install-game) steam_only=1; steam_args=("steam://install/$BEAMNG_APPID") ;;
    # Starts Steam in the tray so it is logged in by the time the game starts.
    --background) steam_only=1; steam_args=(-silent) ;;
    -h|--help) sed -n '2p' "$0"; exit 0 ;;
    *) die "unbekannte Option: $1" ;;
  esac
  shift
done

[[ -f "$(steam_exe)" ]] || die "Steam fehlt. Erst bin/setup ausführen."
# bin/beammp reads these; whoever starts the wineserver first decides MSync for it.
export BEAMNG_BACKEND="$BACKEND" BEAMNG_UPSCALER="$UPSCALER" BEAMNG_PACK="$PACK"
mkdir -p "$DATA/logs"
update_engine_bundles
case "$UPSCALER" in
  metalfx) set_game_retina n ;;
  game|off) set_game_retina y ;;
  *) die "unbekannte Hochskalierung: $UPSCALER" ;;
esac

# The game inherits its environment from steam.exe, not from this script.
# A Steam started with the same backend, HUD and MetalFX setting can take the
# launch as is; dxmt.conf is read by the game itself on every start.
session="$BACKEND hud=${BEAMNG_HUD:-0} upscaler=$UPSCALER pack=$PACK"
session_file="$DATA/steam-session"
# A second steam.exe hands its arguments to the running client and exits
# within seconds. While that client is still starting up (BeamMac starts it in
# the background on launch) the handoff hangs for good and the game never
# starts, so wait for the login first and restart Steam if it never comes.
hand_off() {
  local pid
  ( wine_env "$BACKEND"; exec "$(wine_bin "$BACKEND")" "$(steam_exe)" "$@" ) >>"$DATA/logs/steam.log" 2>&1 &
  pid=$!
  for _ in $(seq "$HANDOFF_TIMEOUT"); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 1
  done
  kill -9 "$pid" 2>/dev/null
  return 1
}

if [[ -z "$update_steam" ]] && steam_running && [[ -n "$steam_only" || "$(cat "$session_file" 2>/dev/null)" == "$session" ]]; then
  log "Steam läuft schon"
  if [[ -z "$steam_only" ]] && ! wait_for_steam_login; then
    log "Steam meldet sich nicht an, starte neu"
  else
    [[ -n "$multiplayer" ]] && "$(dirname "$0")/beammp" start
    hand_off ${steam_args[@]+"${steam_args[@]}"} && exit 0
    log "Steam hat den Start nicht angenommen, starte neu"
  fi
fi

"$(dirname "$0")/stop" >/dev/null
prepare_steam_bootstrap "$update_steam"
configure_steam_app
echo "$session" >"$session_file"

# The launcher lives in the same wineserver, so it starts after the restart.
[[ -n "$multiplayer" ]] && "$(dirname "$0")/beammp" start

log "Starte Steam (Backend: $BACKEND, HUD: ${BEAMNG_HUD:-0}, Hochskalierung: $UPSCALER, Game Pack: $PACK)"
run_wine "$BACKEND" "$(steam_exe)" ${steam_args[@]+"${steam_args[@]}"} >"$DATA/logs/steam.log" 2>&1 &
disown
log "Log: $DATA/logs/steam.log"
