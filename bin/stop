#!/usr/bin/env bash
# Usage: bin/stop   beendet Steam, BeamNG und den wineserver
source "$(dirname "$0")/../lib/common.sh"

for backend in dxmt d3dmetal; do
  if pgrep -qf "$(wineserver_bin "$backend")"; then
    wine_env "$backend"
    "$(wineserver_bin "$backend")" -k 2>/dev/null || true
    "$(wineserver_bin "$backend")" -w 2>/dev/null || true
    log "Gestoppt ($backend)"
  fi
done
